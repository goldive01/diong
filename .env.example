# Diong environment variables.
#
# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API). Never commit .env.local or any
# file containing real values.
#
# Both variables are public by design (they are exposed to the browser). Diong
# never uses the Supabase service-role key.

# Supabase project URL, e.g. https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable ("anon") key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
